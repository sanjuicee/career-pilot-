# ============================================================================
# CAREER PILOT — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
#
# NOTE: Career Pilot is architected as a 100% deterministic, local-first
# client application. It does NOT require any paid cloud AI API keys
# (OpenAI, Anthropic, Gemini, etc.) or external database credentials to function.
#
# All personal assessment processing, matching calculations, and pathway
# syntheses run entirely in-browser memory and HTML5 Web Storage.
# ============================================================================

# Application Environment ('development' | 'production' | 'test')
NODE_ENV=production

# Base URL prefix for deployment (defaults to '/' for root domains)
VITE_BASE_PATH=/

# Build mode identifier
VITE_APP_VERSION=1.0.0
VITE_APP_BUILD_DATE=2026-11-23

# Optional: Port configuration for local preview server
PORT=5173
HOST=127.0.0.1
